# ============================================================
# HAYESH — Environment Variables Template
# Copy this file to .env.local and fill in your real values
# NEVER commit .env.local to Git
# ============================================================

# ── SUPABASE ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_key

# ── FIELD-LEVEL ENCRYPTION (bank account numbers, IBANs) ─────
# Server-only AES-256-GCM key for lib/crypto/field-encryption.ts.
# Must be a 32-byte key, base64-encoded. NEVER prefix with NEXT_PUBLIC_.
# Generate one with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# ── STRIPE (Card payments — OPTIONAL) ────────────────────────
# Card checkout appears automatically once BOTH the secret key and the
# webhook secret are set. Leave empty to run on the manual rail only
# (bank transfer / JazzCash / Easypaisa with admin verification).
# Webhook endpoint: https://YOUR_DOMAIN/api/webhooks/stripe
#   events: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# For testing use sk_test_ and pk_test_ keys first
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── SIMPAISA (Pakistan Payments) ─────────────────────────────
SIMPAISA_API_KEY=your_simpaisa_api_key
SIMPAISA_WEBHOOK_SECRET=your_simpaisa_webhook_secret
NEXT_PUBLIC_SIMPAISA_MERCHANT_ID=your_merchant_id

# ── AI ROUTING ───────────────────────────────────────────────
# Dev:  OmniRoute (localhost:20128) — auto-routes through free tiers
# Prod: OpenRouter (simple/medium) + Anthropic (complex/agentic)
#
# Start OmniRoute: npm install -g omniroute && omniroute
# Dashboard: http://localhost:20128/dashboard

# OmniRoute (dev only — auto-detected, no key needed locally)
# Set this only if you expose OmniRoute on a custom port/host
# OMNIROUTE_BASE_URL=http://localhost:20128/v1

# OpenRouter (production JARVIS — free Llama 4 Maverick tier)
OPENROUTER_API_KEY=sk-or-...

# Anthropic (production AI services — Claude Sonnet)
ANTHROPIC_API_KEY=sk-ant-...

# ── VOICE TRANSLATION ────────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# ── LIVEKIT (Video Sessions) ─────────────────────────────────
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-server.livekit.cloud

# ── APP CONFIG ───────────────────────────────────────────────
# Production: your live domain, e.g. https://hayesh.com (used for SEO,
# sitemap and Stripe return URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Daily commerce cron (/api/cron/commerce): auto-complete deliveries,
# tuition renewals, past-due marking, expiring abandoned checkouts.
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>".
# Generate with: openssl rand -hex 32
CRON_SECRET=
NEXT_PUBLIC_APP_NAME=Hayesh

# Platform commission rates (admin can override in DB)
NEXT_PUBLIC_TEACHER_COMMISSION=15
NEXT_PUBLIC_SELLER_COMMISSION=18

# ── OPTIONAL: ANALYTICS ──────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
